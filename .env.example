APP_NAME=torrent-watchdog
APP_VERSION=0.3.7
APP_HOST=0.0.0.0
APP_PORT=8096
TZ=Asia/Yekaterinburg

DATABASE_URL=sqlite:////data/app.db

QB_HOST=http://192.168.0.220:8090
QB_USERNAME=admin
QB_PASSWORD=adminadmin
QB_VERIFY_TLS=false
QB_TIMEOUT_SECONDS=30

CHECK_INTERVAL_HOURS=24
CHECK_HOUR=4
CHECK_MINUTE=0

DEFAULT_AUTO_UPDATE=false
DEFAULT_RECHECK_AFTER_ADD=true
DEFAULT_START_AFTER_RECHECK=true
DEFAULT_ADD_PAUSED=true

APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change_me
APP_SECRET_KEY=change_me_random_secret

RUTRACKER_ENABLED=true
RUTRACKER_COOKIE=
RUTRACKER_USER_AGENT=Mozilla/5.0
RUTRACKER_RETRY_DELAY_SECONDS=10
RUTRACKER_MAX_ATTEMPTS=3

LOG_LEVEL=INFO
