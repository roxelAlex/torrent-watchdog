APP_NAME=torrent-watchdog
APP_VERSION=0.8.0
APP_HOST=0.0.0.0
APP_PORT=8096
TZ=UTC
# Язык по умолчанию: ru или en. Переключатель в шапке запоминает выбор в cookie.
APP_LANGUAGE=ru

DATABASE_URL=sqlite:////data/app.db

# Клиент по умолчанию. Создаётся в базе при первом запуске; дальше правится
# на странице «Настройки», и эти переменные больше не перечитываются.
QB_HOST=http://192.168.1.10:8080
QB_USERNAME=admin
QB_PASSWORD=adminadmin
QB_VERIFY_TLS=false
QB_TIMEOUT_SECONDS=30
# Таймаут проверки доступности клиента и время жизни кэша статусов и категорий.
QB_PROBE_TIMEOUT_SECONDS=4
QB_STATUS_CACHE_SECONDS=20
QB_CATEGORIES_CACHE_SECONDS=120

# Ежедневная проверка. Применяется при перезапуске контейнера.
CHECK_HOUR=4
CHECK_MINUTE=0
# Сколько раздач проверять одновременно. Обращения к FlareSolverr всё равно
# идут по очереди — один браузер не решает два вызова Cloudflare сразу.
CHECK_MAX_WORKERS=3

# Уборка после ночной проверки. 0 отключает.
EVENT_RETENTION_DAYS=180
TORRENT_FILE_RETENTION_DAYS=30

DEFAULT_AUTO_UPDATE=false
DEFAULT_RECHECK_AFTER_ADD=true
DEFAULT_START_AFTER_RECHECK=true
DEFAULT_ADD_PAUSED=true
# Единственная настройка, разрешающая сервису удалять данные: файлы прошлой
# версии сносятся, только если раздачу пересобрали целиком и ни один файл
# не совпал. Откат и частичные обновления файлы не трогают никогда.
DEFAULT_DELETE_REPLACED_FILES=false

APP_AUTH_ENABLED=true
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=change_me
# Обязательно смените: этим ключом подписывается cookie сессии.
APP_SECRET_KEY=change_me_random_secret

RUTRACKER_ENABLED=true
# Логин и пароль: сервис входит сам и обновляет cookie, когда сессия истекает.
# Обычно задаются на странице «Настройки», а не здесь.
RUTRACKER_USERNAME=
RUTRACKER_PASSWORD=
RUTRACKER_LOGIN_MIN_INTERVAL_SECONDS=300
# Запасной способ: cookie авторизованной сессии, если трекер запросил капчу.
RUTRACKER_COOKIE=
RUTRACKER_USER_AGENT=Mozilla/5.0
RUTRACKER_RETRY_DELAY_SECONDS=10
RUTRACKER_MAX_ATTEMPTS=3
# Значения по умолчанию; страница «Настройки» имеет приоритет над ними.
# Хост flaresolverr включает скачивание браузером через собственный endpoint.
FLARESOLVER_ADDRESS=http://flaresolverr
FLARESOLVER_PORT=8191

# Уведомления в Telegram. Обычно задаются на странице «Настройки».
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# Язык уведомлений — отдельно от языка интерфейса.
NOTIFY_LANGUAGE=ru

LOG_LEVEL=INFO
